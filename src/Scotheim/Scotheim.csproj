<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build: dotnet build -c Release -p:ValheimDir="C:\Program Files (x86)\Steam\steamapps\common\Valheim"
    Needs BepInEx 5 installed into that Valheim folder (e.g. BepInExPack_Valheim). Jötunn comes from NuGet.
    Output: bin/Release/netstandard2.1/Scotheim.dll -> copy to <Valheim>/BepInEx/plugins/
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Scotheim</AssemblyName>
    <RootNamespace>Scotheim</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- JotunnLib ships only a net462 build; like assembly_valheim, it loads fine under the game's Mono. -->
    <AssetTargetFallback>$(AssetTargetFallback);net462</AssetTargetFallback>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <BepInExDir>$(ValheimDir)\BepInEx\core</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Written into BepInEx/config/expand_world/ on first run (see Patches/ExpandWorld.cs). -->
    <EmbeddedResource Include="Data\*.yaml" LogicalName="Scotheim.Data.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim"><HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Only the compile-time Jotunn.dll: the package's build props would add references to publicized
         game assemblies that exist only after Jötunn's own prebuild step. Players install Jötunn separately. -->
    <PackageReference Include="JotunnLib" Version="2.30.2" ExcludeAssets="build;buildTransitive" PrivateAssets="all" />
  </ItemGroup>

  <!-- Also produce bin\<Config>\Scotheim.zip (just the DLL) for mod managers such as Vortex. -->
  <Target Name="PackageForModManagers" AfterTargets="Build">
    <PropertyGroup>
      <PackageDir>$(OutDir)package\</PackageDir>
      <PackageZip>$(OutDir)..\Scotheim.zip</PackageZip>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDir)" />
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Mod manager package: $([System.IO.Path]::GetFullPath('$(PackageZip)'))" />
  </Target>
</Project>
